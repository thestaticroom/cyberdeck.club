---
/**
 * Community Guidelines Page
 *
 * Users must read and accept these protocols before they can
 * publish content (forum posts, builds, wiki articles, comments).
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { hasAcceptedGuidelines, CURRENT_GUIDELINES_VERSION } from "@/lib/guidelines";
import { DeleteAccountModal } from "@/components/settings/DeleteAccountModal";
import { env } from "cloudflare:workers";

export const prerender = false;

// Get user from locals (set by middleware)
const user = Astro.locals.user;
const db = Astro.locals.db;

// Check if user has already accepted guidelines
let alreadyAccepted = false;
if (user && db) {
  alreadyAccepted = await hasAcceptedGuidelines(db, user.id);
}

// Get redirect param for where to send user after acceptance
const redirectTo = Astro.url.searchParams.get("redirect") ?? "/";

// Get public Turnstile site key from Workers env bindings
const turnstileSiteKey = (env as App.Env).PUBLIC_TURNSTILE_SITE_KEY ?? "";
---

<BaseLayout title="Network Protocol - cyberdecks.org">
  <div class="guidelines-page">
    <div class="guidelines-container">
      <div class="guidelines-header">
        <span class="eyebrow">/// COMMUNITY PROTOCOL v{CURRENT_GUIDELINES_VERSION}</span>
        <h1 class="guidelines-title">Network Guidelines</h1>
        <p class="guidelines-intro">
          Before you upload builds, query the forum, or contribute to the wiki, you must sync with our core directives. 
          This network was built for those historically locked out of traditional tech and maker spaces.
        </p>
      </div>

      <div class="guidelines-content">
                <section class="guideline-section">
          <h2>01 // Core Values</h2>
          <p>
            cyberdecks.org is a decentralized collective for hardware hackers, rig-builders, and netrunners. 
            This infrastructure was built for the weirdos, the outcasts, and the beginners. 
            If you want to keep the "punk" in cyberpunk, drag tech out of corporate walled gardens, and build things your own damn way-you belong here.
          </p>
          <p>
            We treat cyberdecks as aesthetic expression and creative self-defense. From a Raspberry Pi wired into a thrifted compact to a custom-milled Pelican case mainframe, all architectures are valid. No gatekeepers. No elitism.
          </p>
        </section>

        <section class="guideline-section">
          <h2>02 // Operating Directives</h2>
          <ul>
            <li>
              <strong>Evaluate the architecture, not just the specs.</strong> A build's value isn't defined by its processor speed. Comment on what makes a rig unique, not what it lacks.
            </li>
            <li>
              <strong>Debug, don't destroy.</strong> If someone requests assistance, offer solutions, not condescension. "Have you considered..." always beats "Why would you..."
            </li>
            <li>
              <strong>Respect identity parameters.</strong> Use the display name and pronouns a user specifies. If unsure, ask politely.
            </li>
            <li>
              <strong>No query is too basic.</strong> We all started with a blank breadboard. Asking "how do I solder?" requires initiative, not weakness.
            </li>
          </ul>
        </section>

        <section class="guideline-section">
          <h2>03 // System Violations (Zero Tolerance)</h2>
          <ul>
            <li>
              <strong>Harassment or exclusionary behavior.</strong> Racism, sexism, homophobia, transphobia, ableism, or any form of hate speech will result in an immediate ban.
            </li>
            <li>
              <strong>Gatekeeping.</strong> Telling someone their build "isn't a real cyberdeck" is a violation. Different aesthetics, skill levels, and contexts are all valid.
            </li>
            <li>
              <strong>Spam and parasitic self-promotion.</strong> Share your builds, but do not just drop external links and vanish. Contribute to the collective.
            </li>
            <li>
              <strong>Doxing or unauthorized data leaks.</strong> Sharing personal information without explicit consent is strictly prohibited.
            </li>
            <li>
              <strong>Intellectual property theft.</strong> Credit your inspirations, attribute properly, and keep it original (or clearly mark derivatives).
            </li>
            <li>
              <strong>Tool-shaming.</strong> Whether a builder uses AI assistance or hand-solders every joint is their call. Bullying users over their creative process is not tolerated.
            </li>
          </ul>
        </section>

        <section class="guideline-section">
          <h2>04 // OpSec & Safety</h2>
          <p>
            Anonymity is a feature, not a bug. We do not require real names, and we respect the choice to remain pseudonymous. Do not pressure others to expose their identity or share more than they are comfortable with.
          </p>
          <p>
            If you detect a protocol violation, flag it for the mod team. We investigate all reports and will execute appropriate countermeasures.
          </p>
        </section>

        <section class="guideline-section">
          <h2>05 // Maintain the Signal</h2>
          <p>
            This isn't a corporate HR document. It's a framework for a collective of builders and creative weirdos forging cool things in the dark. Stay sharp. Stay supportive. Be the version of yourself that helps the next person succeed.
          </p>
        </section>

        <!-- Sentinel element for scroll detection -->
        <div id="scroll-sentinel" class="scroll-sentinel" aria-hidden="true"></div>
      </div>

      <div class="guidelines-action">
        {alreadyAccepted ? (
          <div class="already-accepted">
            <div class="success-icon">✓</div>
            <h2>Sync Complete</h2>
            <p>
              You have already accepted the community protocol (version {CURRENT_GUIDELINES_VERSION}). 
              Thanks for holding the line with us.
            </p>
            <a href={redirectTo} class="btn btn-primary">
              Return to {redirectTo === "/" ? "the mainframe" : "your dashboard"}
            </a>
          </div>
        ) : user ? (
          <div class="acceptance-form">
            <h2>Accept the Protocol</h2>
            <p class="acceptance-instructions">
              Once you have read the directives above and completed the verification, 
              initialize your acceptance below.
            </p>

            <div class="turnstile-container">
              <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-callback="onTurnstileSuccess"></div>
            </div>

            <button
              type="button"
              id="accept-btn"
              class="btn btn-primary accept-btn"
              disabled
            >
              I have read and accept these guidelines
            </button>

            <p id="error-msg" class="error-message" style="display: none;" role="alert"></p>

            <p class="acceptance-note">
              This verification keeps the network secure from spam bots and ensures a high-signal environment.
            </p>
          </div>
        ) : (
          <div class="login-prompt">
            <h2>Authenticate to Accept</h2>
            <p>
              You must be signed in to accept the community protocol and begin publishing content.
            </p>
            <a href={`/login?redirect=${encodeURIComponent(Astro.url.pathname)}`} class="btn btn-primary">
              Sign in or Register
            </a>
            <p class="login-note">
              The system will redirect you back here post-authentication.
            </p>
          </div>
        )}
      </div>

      {/* "Not for me" exit ramp — only show for logged-in users */}
      {user && (
        <div class="not-for-me-section">
          <details class="not-for-me-details">
            <summary class="not-for-me-summary">
              This network isn't for me — I want to terminate my account
            </summary>
            <div class="not-for-me-content">
              <p>
                No hard feelings. If our protocol doesn't align with your objectives, 
                you can delete your account here. Your profile and credentials will be 
                permanently purged, and your content will be anonymized.
              </p>
              <DeleteAccountModal client:load />
            </div>
          </details>
        </div>
      )}
    </div>
  </div>
</BaseLayout>

<script define:vars={{ redirectTo }}>
  // Scroll detection via Intersection Observer
  const sentinel = document.getElementById("scroll-sentinel");
  const acceptBtn = document.getElementById("accept-btn");
  const errorMsg = document.getElementById("error-msg");
  let scrolledToBottom = false;
  let turnstileToken = null;

  function showError(message) {
    if (errorMsg) {
      errorMsg.textContent = message;
      errorMsg.style.display = "block";
    }
  }

  function hideError() {
    if (errorMsg) {
      errorMsg.textContent = "";
      errorMsg.style.display = "none";
    }
  }

  if (sentinel && acceptBtn) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            scrolledToBottom = true;
            updateButtonState();
          }
        });
      },
      { threshold: 1.0 }
    );
    observer.observe(sentinel);
  }

  // Turnstile callback
  window.onTurnstileSuccess = (token) => {
    turnstileToken = token;
    hideError();
    updateButtonState();
  };

  function updateButtonState() {
    if (acceptBtn) {
      if (scrolledToBottom && turnstileToken) {
        acceptBtn.removeAttribute("disabled");
      } else {
        acceptBtn.setAttribute("disabled", "true");
      }
    }
  }

  // Handle acceptance
  if (acceptBtn) {
    acceptBtn.addEventListener("click", async () => {
      if (!turnstileToken) {
        showError("Please complete the verification first.");
        return;
      }

      hideError();
      acceptBtn.setAttribute("disabled", "true");
      acceptBtn.textContent = "Processing...";

      try {
        const res = await fetch("/api/guidelines/accept", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ turnstileToken }),
        });

        if (res.ok) {
          window.location.href = redirectTo;
        } else {
          const data = await res.json();
          if (data.error === "turnstile_verification_failed") {
            showError("Verification failed. Please retry.");
          } else {
            showError(data.error || "System error. Please retry.");
          }
          acceptBtn.removeAttribute("disabled");
          acceptBtn.textContent = "I have read and accept these guidelines";
        }
      } catch (err) {
        showError("Network error. Please retry.");
        acceptBtn.removeAttribute("disabled");
        acceptBtn.textContent = "I have read and accept these guidelines";
      }
    });
  }
</script>

<!-- Cloudflare Turnstile API -->
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<style>
  .guidelines-page {
    min-height: 100vh;
    padding: 3rem 1rem;
    background: var(--bg);
    color: var(--text);
  }

  .guidelines-container {
    max-width: 720px;
    margin: 0 auto;
  }

  .guidelines-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .eyebrow {
    font-family: var(--font-pixel);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    display: inline-block;
    color: var(--color-primary);
    border: 1px solid var(--color-primary);
    background: transparent;
    padding: 0.35rem 0.75rem;
    margin-bottom: 1.5rem;
  }

  .guidelines-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    color: var(--text);
    margin: 0 0 1rem 0;
    line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .guidelines-intro {
    font-size: 1.125rem;
    color: var(--text-muted);
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .guidelines-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 4px solid var(--color-primary);
    padding: 2rem;
    margin-bottom: 2rem;
  }

  .guideline-section {
    margin-bottom: 2.5rem;
  }

  .guideline-section:last-of-type {
    margin-bottom: 0;
  }

  .guideline-section h2 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-primary);
    margin: 0 0 1rem 0;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .guideline-section p {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text);
    margin: 0 0 1rem 0;
  }

  .guideline-section p:last-child {
    margin-bottom: 0;
  }

  .guideline-section ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .guideline-section li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 1rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text);
  }

  .guideline-section li::before {
    content: ">";
    position: absolute;
    left: 0;
    color: var(--color-primary);
    font-family: var(--font-mono);
    font-weight: bold;
  }

  .guideline-section li:last-child {
    margin-bottom: 0;
  }

  .guideline-section strong {
    font-weight: 700;
    color: var(--text);
  }

  .scroll-sentinel {
    height: 1px;
    margin-top: 2rem;
  }

  .guidelines-action {
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 4px solid var(--color-primary);
    padding: 2rem;
    text-align: center;
  }

  .guidelines-action h2 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--text);
    margin: 0 0 1rem 0;
    text-transform: uppercase;
  }

  .guidelines-action p {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 0 0 1rem 0;
  }

  .btn {
    display: inline-block;
    padding: 0.875rem 2rem;
    font-size: 0.9rem;
    font-weight: 700;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border: 1px solid var(--border);
    cursor: pointer;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .btn-primary {
    background: var(--color-primary);
    color: var(--bg);
    border-color: var(--color-primary);
  }

  .btn-primary:hover:not(:disabled) {
    background: var(--color-primary-hover, var(--color-primary));
    box-shadow: 0 0 15px var(--color-primary);
    transform: translateY(-1px);
  }

  .btn-primary:active:not(:disabled) {
    transform: translateY(0);
    box-shadow: 0 0 5px var(--color-primary);
  }

  .btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
    box-shadow: none;
  }

  .accept-btn {
    margin-top: 1.5rem;
    width: 100%;
    max-width: 400px;
  }

  .error-message {
    color: var(--color-danger, #ef4444);
    font-size: 0.875rem;
    font-family: var(--font-mono);
    margin-top: 1rem;
    padding: 0.75rem 1rem;
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid var(--color-danger, #ef4444);
  }

  .turnstile-container {
    display: flex;
    justify-content: center;
    margin: 1.5rem 0;
  }

  .acceptance-instructions {
    max-width: 480px;
    margin: 0 auto 1rem auto;
  }

  .acceptance-note {
    font-size: 0.8rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    margin-top: 1rem;
    opacity: 0.7;
  }

  .already-accepted {
    text-align: center;
  }

  .success-icon {
    width: 64px;
    height: 64px;
    border-radius: 0;
    background: var(--color-primary);
    color: var(--bg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    font-family: var(--font-mono);
    font-weight: bold;
    margin: 0 auto 1rem auto;
    border: 1px solid var(--color-primary);
  }

  .login-prompt {
    text-align: center;
  }

  .login-note {
    font-size: 0.8rem;
    font-family: var(--font-mono);
    margin-top: 1rem;
    opacity: 0.7;
  }

  /* "Not for me" exit ramp */
  .not-for-me-section {
    margin-top: 2rem;
  }

  .not-for-me-details {
    border: 1px solid var(--color-danger);
    background: rgba(239, 68, 68, 0.05);
  }

  .not-for-me-summary {
    padding: 1rem 1.5rem;
    cursor: pointer;
    font-size: 0.875rem;
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--color-danger);
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .not-for-me-summary::-webkit-details-marker {
    display: none;
  }

  .not-for-me-summary::before {
    content: ">";
    display: inline-block;
    transition: transform 0.15s ease;
    font-size: 0.75rem;
  }

  .not-for-me-details[open] .not-for-me-summary::before {
    transform: rotate(90deg);
  }

  .not-for-me-content {
    padding: 1.25rem 1.5rem;
    border-top: 1px solid var(--color-danger);
  }

  .not-for-me-content p {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 0 0 1rem 0;
  }

  @media (max-width: 640px) {
    .guidelines-page {
      padding: 2rem 0.75rem;
    }

    .guidelines-content,
    .guidelines-action {
      padding: 1.5rem;
    }

    .not-for-me-summary {
      padding: 0.75rem 1rem;
    }

    .not-for-me-content {
      padding: 1rem;
    }
  }
</style>