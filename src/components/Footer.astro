---
const footerLinks = [
  { label: "Wiki", url: "/wiki/", ariaLabel: "Go to Wiki" },
  { label: "Forum", url: "/forum/", ariaLabel: "Go to Forum" },
  { label: "Builds", url: "/builds/", ariaLabel: "Go to Builds" },
  { label: "Meetups", url: "/meetups/", ariaLabel: "Go to Meetups" },
  { label: "Announcements", url: "/announcements/", ariaLabel: "View site announcements" },
  { label: "About", url: "/about/", ariaLabel: "Go to About" },
  { label: "Guidelines", url: "/guidelines/", ariaLabel: "Read our community guidelines" },
];

const socialLinks = [
  { label: "GitHub", url: "https://github.com/thestaticroom/cyberdeck.club", icon: "github" },
];
---

<footer class="footer overflow-hidden mt-auto border-t-8 pb-[env(safe-area-inset-bottom)]">
  <div class="footer-main pt-12 pb-8">
    <div class="max-w-6xl mx-auto px-6">
      <!-- Main footer content -->
      <div class="pb-12 grid grid-cols-1 lg:grid-cols-3 gap-12 lg:gap-32 lg:pb-16">
        <!-- Brand column -->
        <div class="flex flex-col max-w-xl gap-6 lg:col-span-2">
          <div class="footer-brand">
            <h2 class="footer-tagline text-3xl font-bold tracking-tight lg:text-4xl">
              Build. Make. Connect.
            </h2>
            <p class="footer-description mt-4 text-lg">
              The community for cyberdeck builders, DIY enthusiasts, and retro-computing fans.
              Share your builds, learn new skills, and connect with fellow makers. 
            </p>
          </div>

          <!-- Social links -->
          <div class="flex flex-wrap gap-4 mt-4">
            {socialLinks.map((link) => (
              <a
                href={link.url}
                class="social-link px-5 py-2 rounded-full font-medium transition-all duration-200 hover:scale-105"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Visit us on ${link.label}`}
              >
                {link.label}
              </a>
            ))}
            <a
              href="https://www.buymeacoffee.com/thestaticroom"
              class="social-link px-5 py-2 rounded-full font-medium transition-all duration-200 hover:scale-105"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Support us on Buy Me a Coffee"
            >
              ☕ Buy Me a Coffee
            </a>
          </div>
        </div>

        <!-- Quick links column -->
        <nav
          class="footer-nav flex flex-col justify-between text-base gap-y-4"
          role="navigation"
          aria-label="Footer navigation"
        >
          <h3 class="footer-nav-title font-bold text-lg mb-2">Quick Links</h3>
          {footerLinks.map((link) => (
            <a
              class="footer-nav-link transition-colors duration-200 hover:text-primary"
              href={link.url}
              aria-label={link.ariaLabel}
            >
              {link.label}
            </a>
          ))}
        </nav>
      </div>

      <!-- Divider -->
      <div class="footer-divider border-t opacity-30"></div>

      <!-- Bottom bar -->
      <div class="pt-6 flex flex-col md:flex-row justify-between items-center gap-4">
        <div class="flex flex-col md:flex-row items-center gap-4 md:gap-6">
          <p class="footer-copyright text-sm">
            © 2026 cyberdecks.org. Built with 💖 and too much caffeine.
          </p>
        </div>

        <div class="flex items-center gap-6">
          <a
            href="/login"
            class="footer-admin-link text-sm transition-colors duration-200 hover:text-primary"
          >
            Admin Login
          </a>
          <p class="footer-credit text-sm opacity-75">
            Built with 💖 by the cyberdeck community
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Decorative sparkles -->
  <div class="footer-sparkles hidden md:block" aria-hidden="true">
    <div class="sparkle sparkle-1"></div>
    <div class="sparkle sparkle-2"></div>
    <div class="sparkle sparkle-3"></div>
  </div>
</footer>

<style>
  /* Base footer styles using semantic tokens (matches Nav) */
  .footer {
    background-color: var(--bg);
    border-color: var(--border);
  }

  .footer-main {
    background-color: var(--bg);
  }

  .footer-tagline,
  .footer-nav-title {
    color: var(--text);
  }

  .footer-description {
    color: var(--text-muted);
  }

  .social-link {
    background-color: var(--color-primary);
    color: var(--text-inverse);
    border: 2px solid var(--color-primary);
  }

  .social-link:hover {
    background-color: var(--color-secondary);
    border-color: var(--color-secondary);
  }

  .footer-nav-link,
  .footer-copyright,
  .footer-admin-link,
  .footer-credit {
    color: var(--text);
  }

  .footer-nav-link:hover,
  .footer-admin-link:hover {
    color: var(--color-primary);
  }

  .footer-divider {
    border-color: var(--border);
  }

  /* Decorative sparkles (using theme accents) */
  .sparkle {
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    opacity: 0.6;
  }

  .sparkle-1 {
    background-color: var(--color-pop-mint);
    bottom: 20%;
    right: 15%;
    animation: sparkle-pulse 3s ease-in-out infinite;
  }

  .sparkle-2 {
    background-color: var(--color-pop-sky);
    bottom: 35%;
    right: 25%;
    animation: sparkle-pulse 3s ease-in-out infinite 1s;
  }

  .sparkle-3 {
    background-color: var(--color-pop-lemon);
    bottom: 15%;
    right: 20%;
    animation: sparkle-pulse 3s ease-in-out infinite 2s;
  }

  @keyframes sparkle-pulse {
    0%, 100% { transform: scale(1); opacity: 0.6; }
    50% { transform: scale(1.5); opacity: 1; }
  }
</style>